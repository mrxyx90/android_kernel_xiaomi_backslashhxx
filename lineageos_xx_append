# ---- Maximum Performance & Mitigation Disables ---- 
CONFIG_LOCALVERSION_AUTO=y 
CONFIG_CMDLINE="cgroup_disable=memory kpti=0 nosoftlockup noirqdebug" 
CONFIG_CMDLINE_EXTEND=y 
 
# Strip security overhead for raw CPU throughput 
CONFIG_HARDEN_BRANCH_PREDICTOR=n 
CONFIG_ARM64_SSBD=n 
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=n 
 
# ---- Compiler & Optimization ---- 
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y 
CONFIG_CC_OPTIMIZE_FOR_SIZE=n 
CONFIG_OPTIMIZE_INLINING=y 
CONFIG_JUMP_LABEL=y 
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y 
 
# ---- Scheduler & CPU (BORE + WALT for SD625) ---- 
CONFIG_ARM_CPUIDLE=y 
CONFIG_SCHED_AUTOGROUP=y 
CONFIG_DEFAULT_USE_ENERGY_AWARE=y 
CONFIG_SCHED_BORE=y 
CONFIG_SCHED_WALT=y 
CONFIG_CPU_BOOST=n 
CONFIG_SCHED_TUNE=n 
CONFIG_SCHED_CORE_CTL=n 
 
# Performance Governor as Default for Max Speed 
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y 
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y 
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
 
CONFIG_KPROBES=n 
CONFIG_HAVE_KPROBES=n 
CONFIG_KPROBE_EVENTS=n 
CONFIG_KPROBE_EVENT=n 
 
# ---- IRQ Balancing ---- 
CONFIG_IRQ_SBALANCE=y 
CONFIG_SBALANCE_EXCLUDE_CPUS="3,7" 
 
# ---- Memory & ZRAM (Aggressive Performance) ---- 
CONFIG_ZRAM=y 
CONFIG_ZRAM_ENTROPY=y 
CONFIG_ZRAM_ENTROPY_THRESHOLD=100000 
CONFIG_ANON_MIN_KBYTES=393216 
CONFIG_CLEAN_LOW_KBYTES=393216 
CONFIG_CLEAN_MIN_KBYTES=196608 
CONFIG_PROCESS_RECLAIM=n 
CONFIG_BALANCE_ANON_FILE_RECLAIM=n 
CONFIG_KSM=n 
CONFIG_ZRAM_WRITEBACK=n 
CONFIG_ZRAM_DEFAULT_COMP_ALGORITHM="lz4" 
 
# ---- I/O Schedulers ---- 
CONFIG_IOSCHED_NOOP=y 
CONFIG_IOSCHED_DEADLINE=y 
CONFIG_IOSCHED_BFQ=y 
CONFIG_BFQ_GROUP_IOSCHED=y 
CONFIG_DEFAULT_BFQ=y 
 
# ---- Network (BBRplus for speed) ---- 
CONFIG_NET_SCH_FQ_CODEL=y 
CONFIG_DEFAULT_FQ_CODEL=y 
CONFIG_TCP_CONG_ADVANCED=y 
CONFIG_TCP_CONG_BBRPLUS=y 
CONFIG_DEFAULT_BBRPLUS=y 
 
# ---- Crypto & Compression ---- 
CONFIG_CRYPTO_DEFLATE=y 
CONFIG_CRYPTO_LZO=y 
CONFIG_CRYPTO_LZ4=y 
CONFIG_CRYPTO_ZSTD=y 
 
# ---- Essential Drivers (DO NOT BREAK MODULES) ---- 
CONFIG_MODULES=y 
CONFIG_MODULE_SIG=n 
CONFIG_WIREGUARD=y 
CONFIG_FB_MSM_MDSS_KCAL_CTRL=y 
CONFIG_DIAG_CHAR=y 
CONFIG_DIAG_OVER_USB=y 
CONFIG_SECURITY_NETWORK=y 
CONFIG_SECURITY_SMACK=n 
CONFIG_SIMPLE_GPU_ALGORITHM=y 
CONFIG_USB_SERIAL=y 
CONFIG_USB_SERIAL_CH341=y 
 
# ---- Strip Debugging Overhead (Maximum CPU Cycles Saved) ---- 
CONFIG_STACKTRACE_SUPPORT=n 
CONFIG_QTI_RPM_STATS_LOG=n 
CONFIG_SECURITY_SELINUX_AVC_STATS=n 
CONFIG_DEBUG_INFO=n 
CONFIG_PM_DEBUG=n 
CONFIG_PM_SLEEP_DEBUG=n 
CONFIG_SPMI_MSM_PMIC_ARB_DEBUG=n 
CONFIG_MSM_CAMERA_DEBUG=n 
CONFIG_MSMB_CAMERA_DEBUG=n 
CONFIG_SLUB_DEBUG=n 
CONFIG_HAVE_DMA_API_DEBUG=n 
CONFIG_FB_MSM_MDSS_XLOG_DEBUG=n 
CONFIG_IOMMU_DEBUG=n 
CONFIG_IOMMU_DEBUG_TRACKING=n 
CONFIG_MSM_SMD_DEBUG=n 
CONFIG_SCHED_DEBUG=n 
CONFIG_MMC_PERF_PROFILING=n 
CONFIG_SCHEDSTATS=n 
CONFIG_REGMAP_ALLOW_WRITE_DEBUGFS=n 
CONFIG_USB_GADGET_DEBUG_FILES=n 
CONFIG_USB_GADGET_DEBUG_FS=n 
CONFIG_DEBUG_ALIGN_RODATA=n 
CONFIG_IPC_LOGGING=n 
CONFIG_BT_DEBUGFS=n 
CONFIG_MSM_TZ_LOG=n 
CONFIG_QCOM_RUN_QUEUE_STATS=n 
CONFIG_MSM_BOOT_STATS=n 
CONFIG_MSM_IDLE_STATS=n 
CONFIG_TASKSTATS=n 
CONFIG_CPU_FREQ_TIMES=n 
CONFIG_MSM_EVENT_TIMER=n 
CONFIG_QCOM_MEMORY_DUMP_V2=n 
CONFIG_AUDIT=n 
CONFIG_NL80211_TESTMODE=n 
CONFIG_TRIM_UNUSED_KSYMS=y
